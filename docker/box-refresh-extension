#!/bin/bash
# The box's extension runs as a service worker, and Chromium goes on running the worker script a
# profile registered first: a profile kept from an image with an older extension ran the old
# background script, and the page's focus was never reported (10 Oct 2026). A new extension
# version did not change that. So when the extension's files differ from the ones this profile
# (BOX_CHROME_PROFILE) last started with, its service workers are cleared once, before its
# Chromium starts, and every worker (the extension's, and any a site had) registers anew.
#
# Run only while no Chromium has this profile open: the entrypoint before the shared screen's,
# box-screen before a Bot's own.
set -euo pipefail
profile="${BOX_CHROME_PROFILE:-${HOME:-/home/box}/chrome-profile}"
[[ -n "${profile}" && -d "${profile}" ]] || exit 0
stamp="${profile}/.box-active-tab.sha256"
now="$(cat /opt/box/active-tab/* | sha256sum | cut -d' ' -f1)"
if [[ -f "${stamp}" && "$(cat "${stamp}")" == "${now}" ]]; then
  exit 0
fi
if [[ -d "${profile}/Default/Service Worker" ]]; then
  echo "the box extension changed; clearing the profile's service workers once"
  rm -rf -- "${profile}/Default/Service Worker"
fi
printf '%s\n' "${now}" >"${stamp}"
