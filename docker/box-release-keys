#!/bin/sh
# Let go of every modifier and mouse button the X server thinks is held.
#
# A VNC client that goes away mid-keystroke (the person closed the window with
# a ⌘ shortcut, switched apps, lost the connection) leaves its key-downs in the
# X server with no key-up ever coming: from then on every letter is a shortcut
# (Alt+F opens Chromium's menu, Super+E the file manager) and nothing types.
# x11vnc runs this when a client connects and when one leaves; it is also safe
# to run by hand.
export DISPLAY="${DISPLAY:-:1}"
xdotool keyup Super_L Super_R Alt_L Alt_R Meta_L Meta_R Control_L Control_R Shift_L Shift_R Hyper_L Hyper_R ISO_Level3_Shift 2>/dev/null || true
xdotool mouseup 1 2 3 2>/dev/null || true
exit 0
