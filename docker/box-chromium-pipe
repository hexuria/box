#!/bin/sh
# Chromium with its DevTools protocol on a pipe, for the server that started it and nobody
# else. The server runs this through `docker exec -i`: Chromium reads protocol messages
# from fd 3 and writes them to fd 4, and this script wires fd 3 to the exec's stdin and
# fd 4 to its stdout. No port is opened, no socket is made, so nothing inside the box —
# not the bot's shell — can reach the protocol; when the exec's stdin closes, Chromium
# exits. Same profile and proxy rules as box-chromium, so a later `box-chromium <url>`
# opens its tab in this instance.
#
# The DevTools protocol is what a saved passkey rides on (a virtual authenticator holds
# the key for the moment of one sign-in); a password never goes this way.
if [ -n "${BOX_CHROME_PIPE_LOG:-}" ]; then
  log="${BOX_CHROME_PIPE_LOG}"
else
  log=/tmp/box-chrome-pipe.log
fi
proxy_server=""
proxy_bypass=""
proxy_webrtc=""
port_file="/tmp/box-egress-proxy.port"
tunnel="${BOX_EGRESS_TUNNEL:-}"
port="${BOX_EGRESS_PROXY_PORT:-}"
if [ -z "${tunnel}" ] && [ -r "${port_file}" ]; then tunnel=1; fi
if [ -z "${port}" ] && [ -r "${port_file}" ]; then port="$(cat "${port_file}")"; fi
case "$(echo "${tunnel:-0}" | tr '[:upper:]' '[:lower:]')" in
  0|false|off|no) ;;
  *)
    if [ -z "${port}" ]; then
      echo "box-chromium-pipe: the egress tunnel is on but its proxy port is unknown; refusing to start unproxied" >&2
      exit 1
    fi
    proxy_server="--proxy-server=http://127.0.0.1:${port}"
    proxy_bypass="--proxy-bypass-list=localhost;127.0.0.1;[::1];<-loopback>"
    proxy_webrtc="--force-webrtc-ip-handling-policy=disable_non_proxied_udp"
    ;;
esac
export DISPLAY="${BOX_DISPLAY:-:1}"
exec chromium \
  --user-data-dir="${BOX_CHROME_PROFILE:-/home/box/chrome-profile}" \
  --no-first-run \
  --no-default-browser-check \
  --disable-dev-shm-usage \
  --disable-gpu \
  --no-sandbox \
  --test-type \
  --hide-crash-restore-bubble \
  --disable-session-crashed-bubble \
  --disable-features=Translate \
  --window-size="${BOX_SCREEN_W:-1280},${BOX_SCREEN_H:-800}" \
  --window-position=0,0 \
  --remote-debugging-pipe \
  ${proxy_server} \
  ${proxy_bypass} \
  ${proxy_webrtc} \
  "${@:-about:blank}" \
  3<&0 4>&1 2>>"${log}" >>"${log}"
