# EnsureBox base URL (L2). L1 never talks to guest daemons.
ENSUREBOX_URL=http://127.0.0.1:43142

# Server-side token for EnsureBox /api/v1. Never sent to the browser.
ENSUREBOX_TOKEN=dev-ensurebox-token
ENSUREBOX_ALLOW_INSECURE_DEV=1

# Human login for this demo UI (httpOnly cookie). Not the guest bearer.
L1_TOKEN=dev-l1-token
L1_ALLOW_INSECURE_DEV=1
