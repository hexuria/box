# Bearer token for EnsureBox HTTP APIs and the operator login (not the guest token).
# Required. Rejected if empty, shorter than 16 characters, or the well-known
# demo value unless ENSUREBOX_ALLOW_INSECURE_DEV=1.
ENSUREBOX_TOKEN=dev-ensurebox-token
ENSUREBOX_ALLOW_INSECURE_DEV=1

# grok-box image created by `docker compose build` in the repo root.
GROK_BOX_IMAGE=grok-box:local

# Host bind for published guest ports (loopback).
# ENSUREBOX_BIND=127.0.0.1

# ENSUREBOX_DATA_DIR=./data
# ENSUREBOX_READY_TIMEOUT_MS=90000
