# Shared bearer token for box-exec, CUA, and box-host unless BOX_HOST_TOKEN is set.
# Required. Compose fails if this is unset or empty. Do not use dev-box-token.
# Generate one: openssl rand -base64 32
BOX_TOKEN=replace-with-a-long-random-token

# Optional separate token for box-host /v1/info /v1/desktop /v1/chrome. Defaults to BOX_TOKEN.
# BOX_HOST_TOKEN=

# Independent VNC password. Required when the desktop is on. x11vnc uses at most 8 characters.
# Must not be derived from BOX_TOKEN. 6080 has no Bearer auth — loopback publish is the control.
BOX_VNC_PASSWORD=replace8

# Stable id reported by box-host. Defaults to HOSTNAME or "grok-box".
BOX_ID=local-dev

# Jail root for exec cwd + file APIs. Inside the image this is /workspace.
# WORKSPACE_ROOT=/workspace

# Bind addresses. Rust/native default is 127.0.0.1. The guest image listens on
# 0.0.0.0 *inside* the container so Compose port-map works. Host publish is 127.0.0.1.
# BOX_EXEC_BIND=0.0.0.0:1337
# BOX_HOST_BIND=0.0.0.0:1340

# URL box-host uses to probe box-exec readiness (container-local; not an SDK connect URL).
# BOX_EXEC_URL=http://127.0.0.1:1337

# Optional browser origin allowlist for guest CORS. Empty = no browser origins. "*" is ignored.
# BOX_CORS_ORIGINS=

# Allow well-known/short BOX_TOKEN only when both daemon binds are loopback (native runner).
# Never set this on a VM that publishes 0.0.0.0.
# BOX_ALLOW_INSECURE_DEV=1

# Desktop / CUA
# BOX_DESKTOP=1
# BOX_DESKTOP_REQUIRED=1
# BOX_DISPLAY=:1
# BOX_DISPLAY_GEOM=1280x800x24
# BOX_VNC_BIND=127.0.0.1:5900
# BOX_NOVNC_PORT=6080

# Chromium (CDP is localhost only — do not publish 9222)
# BOX_CHROME=1
# BOX_CHROME_PROFILE=/home/box/chrome-profile
# BOX_CDP_PORT=9222

# Computer Use actuators on box-exec
# BOX_CUA=1

RUST_LOG=info
