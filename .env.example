# Shared bearer token for box-exec, CUA, and box-host unless BOX_HOST_TOKEN is set.
BOX_TOKEN=dev-box-token

# Optional separate token for box-host /v1/info /v1/desktop /v1/chrome. Defaults to BOX_TOKEN.
# BOX_HOST_TOKEN=

# Stable id reported by box-host. Defaults to HOSTNAME or "grok-box".
BOX_ID=local-dev

# Jail root for exec cwd + file APIs. Inside the image this is /workspace.
# WORKSPACE_ROOT=/workspace

# Bind addresses (Docker defaults shown).
# BOX_EXEC_BIND=0.0.0.0:1337
# BOX_HOST_BIND=0.0.0.0:1340

# URL box-host uses to probe box-exec readiness.
# BOX_EXEC_URL=http://127.0.0.1:1337

# Desktop / CUA
# BOX_DESKTOP=1
# BOX_DESKTOP_REQUIRED=1
# BOX_DISPLAY=:1
# BOX_DISPLAY_GEOM=1280x800x24
# BOX_VNC_BIND=127.0.0.1:5900
# BOX_NOVNC_PORT=6080
# BOX_VNC_PASSWORD=          # default: first 8 chars of BOX_TOKEN

# Chromium (CDP is localhost only — do not publish 9222)
# BOX_CHROME=1
# BOX_CHROME_PROFILE=/home/box/chrome-profile
# BOX_CDP_PORT=9222

# Computer Use actuators on box-exec
# BOX_CUA=1

RUST_LOG=info
